---
import Icon from './Icon.astro';
---
<dialog id="figure-viewer" class="figure-viewer" aria-labelledby="figure-viewer-title">
  <div class="figure-viewer-panel">
    <div class="figure-viewer-header">
      <p id="figure-viewer-title"></p>
      <button class="figure-viewer-close" type="button" aria-label="Close figure preview" autofocus>
        <Icon name="close" size={18} /><span>Close</span>
      </button>
    </div>
    <div class="figure-viewer-stage"><img data-full-figure alt="" /></div>
  </div>
</dialog>

<script>
  const viewer = document.querySelector<HTMLDialogElement>('#figure-viewer');
  const image = viewer?.querySelector<HTMLImageElement>('[data-full-figure]');
  const title = viewer?.querySelector<HTMLElement>('#figure-viewer-title');
  const closeButton = viewer?.querySelector<HTMLButtonElement>('.figure-viewer-close');

  if (viewer && image && title && closeButton && typeof viewer.showModal === 'function') {
    let trigger: HTMLAnchorElement | null = null;
    let pressedBackdrop = false;

    document.querySelectorAll<HTMLAnchorElement>('[data-figure-link]').forEach(link => {
      link.setAttribute('aria-haspopup', 'dialog');
      link.setAttribute('aria-controls', viewer.id);
      link.setAttribute('aria-label', `Enlarge figure for ${link.dataset.figureTitle}`);
      link.title = 'Enlarge figure';
      link.addEventListener('click', event => {
        // Preserve ordinary modified-click / open-in-new-tab link behavior.
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        trigger = link;
        title.textContent = link.dataset.figureTitle || 'Publication figure';
        image.alt = link.querySelector('img')?.alt || 'Publication figure';
        image.src = link.href;
        document.documentElement.classList.add('figure-viewer-open');
        viewer.showModal();
      });
    });

    closeButton.addEventListener('click', () => viewer.close());
    // Native dialog handles Escape and keeps keyboard focus inside the modal.
    viewer.addEventListener('pointerdown', event => { pressedBackdrop = event.target === viewer; });
    viewer.addEventListener('click', event => {
      if (pressedBackdrop && event.target === viewer) viewer.close();
      pressedBackdrop = false;
    });
    viewer.addEventListener('close', () => {
      document.documentElement.classList.remove('figure-viewer-open');
      image.removeAttribute('src');
      trigger?.focus({ preventScroll: true });
      trigger = null;
    });
  }
</script>
