---
import { siGithub, siGooglescholar, siX } from 'simple-icons';
interface Props { name: string; size?: number; }
const { name, size = 20 } = Astro.props;
const brandPaths: Record<string, string> = {
  github: siGithub.path,
  scholar: siGooglescholar.path,
  x: siX.path,
  linkedin: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.049c.476-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
};
---
<svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill={brandPaths[name] ? 'currentColor' : 'none'}>
  {brandPaths[name] ? <path d={brandPaths[name]} /> : name === 'email' ? (
    <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4.5" width="19" height="15" rx="2" /><path d="m3 6 9 7 9-7" /></g>
  ) : name === 'arrow' ? (
    <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 18 18 6M6 6h12v12" /></g>
  ) : name === 'pause' ? (
    <g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 5v14M15 5v14" /></g>
  ) : name === 'close' ? (
    <g stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="m6 6 12 12M18 6 6 18" /></g>
  ) : (
    <path d="m9 5 10 7-10 7Z" fill="currentColor" />
  )}
</svg>
