---
import { Image, getImage } from 'astro:assets';
import Page from '../layouts/Page.astro';
import Icon from '../components/Icon.astro';
import ResearchRow from '../components/ResearchRow.astro';
import FigureViewer from '../components/FigureViewer.astro';
import { profile, socials, academicProfiles, experiences, formatMonth } from '../data/profile';
import { papers } from '../data/research';
import portrait from '../assets/portrait.jpg';

// Structured data (Google's ProfilePage pattern): this page is about one Person,
// linked to their other profiles and authored papers, so searches can connect them.
const homeUrl = new URL('/', Astro.site).href;
const personId = `${homeUrl}#person`;
const personImage = await getImage({ src: portrait, width: 480, format: 'webp', quality: 90 });
const profilePage = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: homeUrl,
  // Update dateModified when the visible profile content changes.
  dateCreated: '2026-11-17T03:00:30-05:00',
  dateModified: '2026-11-17T17:24:09-05:00',
  mainEntity: {
    '@type': 'Person',
    '@id': personId,
    name: profile.name,
    givenName: 'David',
    familyName: 'Huang',
    url: homeUrl,
    image: new URL(personImage.src, Astro.site).href,
    description: profile.description,
    affiliation: { '@type': 'CollegeOrUniversity', name: profile.university, url: profile.universityUrl },
    knowsAbout: ['Video generation', '3D vision', 'Multimodal reasoning', '3D reconstruction', 'Diffusion models'],
    sameAs: [...socials, ...academicProfiles].filter(link => link.href.startsWith('https://')).map(link => link.href),
  },
  hasPart: papers.map(paper => ({
    '@type': 'ScholarlyArticle',
    headline: paper.title,
    url: paper.links[0].href,
    author: paper.authors.map(author => author.name === profile.name
      ? { '@id': personId }
      : { '@type': 'Person', name: author.name }),
  })),
};
---
<Page>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(profilePage)} />
  <header class="site-header">
    <a class="wordmark" href="#about" aria-label="David Huang, about">David Huang<span class="wordmark-dot" aria-hidden="true">.</span></a>
    <nav aria-label="Main navigation"><a href="#experience">Experience</a><a href="#research">Publications</a></nav>
  </header>
  <main id="main">
    <section class="intro" id="about" aria-labelledby="name">
      <div class="portrait-wrap">
        <Image class="portrait" src={portrait} alt="Portrait of David Huang" widths={[240, 480, 720]} sizes="(max-width: 640px) 172px, 218px" format="webp" quality={90} loading="eager" fetchpriority="high" />
      </div>
      <div class="intro-copy">
        <h1 id="name">David Huang</h1>
        <p class="intro-affiliation">Computer Engineering · University of Toronto</p>
        <p>I am a Computer Engineering undergraduate at the <a href={profile.universityUrl}>University of Toronto</a>, graduating in 2027. My research spans <strong>video generation</strong>, <strong>3D vision</strong>, and <strong>multimodal reasoning</strong>.</p>
        <p>I aim to build models that can generate, understand, and reason about the visual world. My recent work covers efficient 3D reconstruction, controllable video generation, and reasoning in latent spaces. I am applying to <strong>PhD programs for Fall 2027</strong>, and I am also open to industry research roles.</p>
        <div class="social-links" aria-label="Contact and profiles">
          {socials.filter(social => social.href).map(social => <a href={social.href} class="social-link" aria-label={social.name}><Icon name={social.icon} /><span class="social-tooltip" aria-hidden="true">{social.name}</span></a>)}
        </div>
      </div>
    </section>
    <section class="section experience-section" id="experience" aria-labelledby="experience-heading">
      <div class="section-heading"><h2 id="experience-heading">Experience</h2></div>
      <ol class="experience-list">
        {experiences.map(experience => <li class="experience-row">
          <div class:list={['org-logo', experience.logoClass]}><img src={experience.logo} alt="" width="44" height="44" loading="lazy" /></div>
          <div class="experience-copy">
            <div class="experience-topline">
              <h3><a href={experience.url}>{experience.organization}</a></h3>
              <p class="experience-dates"><time datetime={experience.start}>{formatMonth(experience.start)}</time> – <time datetime={experience.end}>{formatMonth(experience.end)}</time></p>
            </div>
            <p class="role">{experience.role}</p>
            <p class="experience-description">{experience.description}</p>
          </div>
        </li>)}
      </ol>
    </section>
    <section class="section research-section" id="research" aria-labelledby="research-heading">
      <div class="section-heading"><h2 id="research-heading">Publications</h2><p>* Equal contribution</p></div>
      <div class="research-list">{papers.map(paper => <ResearchRow paper={paper} />)}</div>
    </section>
  </main>
  <footer class="site-footer"><span>© {new Date().getFullYear()} David Huang</span><a href="#about">Back to top <span aria-hidden="true">↑</span></a></footer>
  <FigureViewer />
</Page>

<script>
  // Video previews are optional. Stills remain visible with reduced motion,
  // unsupported playback, or no JavaScript; offscreen videos stop immediately.
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('[data-preview]').forEach(container => {
    const video = container.querySelector<HTMLVideoElement>('[data-research-video]');
    const button = container.querySelector<HTMLButtonElement>('[data-video-toggle]');
    if (!video || !button) return;
    let visible = false;
    let manuallyPaused = false;
    const updateButton = () => {
      const playing = !video.paused;
      container.classList.toggle('is-playing', playing);
      button.setAttribute('aria-pressed', String(playing));
      button.setAttribute('aria-label', `${playing ? 'Pause' : 'Play'} research preview`);
      button.querySelector<HTMLElement>('[data-play-icon]')!.hidden = playing;
      button.querySelector<HTMLElement>('[data-pause-icon]')!.hidden = !playing;
    };
    const play = () => {
      const source = video.querySelector<HTMLSourceElement>('source');
      if (source && !source.src && source.dataset.src) { source.src = source.dataset.src; video.load(); }
      video.play().catch(() => updateButton());
    };
    const sync = () => {
      if (visible && !document.hidden && !reducedMotion.matches && !manuallyPaused) play();
      else video.pause();
    };
    video.addEventListener('play', updateButton);
    video.addEventListener('pause', updateButton);
    video.addEventListener('error', () => { video.pause(); container.classList.remove('is-playing'); button.hidden = true; });
    button.addEventListener('click', () => { manuallyPaused = !video.paused; if (manuallyPaused) video.pause(); else play(); });
    const observer = new IntersectionObserver(entries => { visible = entries[0].isIntersecting; sync(); }, { threshold: 0.2 });
    observer.observe(container);
    reducedMotion.addEventListener('change', sync);
    document.addEventListener('visibilitychange', sync);
  });
</script>
